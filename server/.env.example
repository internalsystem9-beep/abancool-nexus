# =============================================================
# ABANCOOL Command Center API — environment configuration
# Copy to .env and fill in the values. Never commit .env.
# =============================================================

# --- Server ---
PORT=4000
NODE_ENV=production
APP_NAME=ABANCOOL Command Center

# --- CORS (comma separated origins) ---
CORS_ORIGINS=https://your-frontend.lovable.app,http://localhost:5173

# --- Database (cPanel MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_abancool
DB_PASSWORD=change_me
DB_NAME=cpaneluser_abancool

# --- Auth ---
JWT_SECRET=replace_with_a_64_char_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- OTP / 2FA ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Mail (SMTP) - cPanel mail or any provider ---
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=change_me
MAIL_FROM="ABANCOOL Command Center <noreply@yourdomain.com>"

# When true, OTP codes are also returned in API responses (development only)
OTP_DEV_RETURN=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
