# Server
PORT=4000
NODE_ENV=production

# CORS — comma separated origins
CORS_ORIGINS=https://your-frontend.lovable.app,http://localhost:5173

# Database (MySQL — cPanel format)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_abancool
DB_PASSWORD=change_me
DB_NAME=cpaneluser_abancool

# Auth
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
