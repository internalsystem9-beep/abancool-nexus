{
  "name": "abancool-command-center-api",
  "version": "1.0.0",
  "description": "ABANCOOL Command Center REST API — Node.js + Express + MySQL (cPanel-ready)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/scripts/migrate-cli.js up",
    "migrate:down": "node src/scripts/migrate-cli.js down",
    "migrate:down-all": "node src/scripts/migrate-cli.js down-all",
    "migrate:status": "node src/scripts/migrate-cli.js status",
    "seed": "node src/scripts/seed.js",
    "create-admin": "node src/scripts/create-admin.js",
    "test": "mocha tests/**/*.test.js --timeout 10000",
    "test:auth": "mocha tests/auth.test.js --timeout 10000"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.15",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mocha": "^10.8.2",
    "nodemon": "^3.1.7"
  }
}
