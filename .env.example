# ABANCOOL Backend Environment Configuration

# ============================================================================
# APPLICATION
# ============================================================================

# Environment: development, staging, production
NODE_ENV=production

# Server
PORT=4000
HOST=0.0.0.0

# API Configuration
API_VERSION=v1
API_BASE_URL=https://api.abancool.com
FRONTEND_URL=https://app.abancool.com

# ============================================================================
# DATABASE
# ============================================================================

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=abancool_user
DB_PASSWORD=your_secure_password_here
DB_NAME=abancool_production
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# Database Backups
DB_BACKUP_DIR=/var/backups/abancool
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRY=7d

# OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@abancool.com
SMTP_FROM_NAME=ABANCOOL Support

# Email Templates
EMAIL_TEMPLATE_PATH=/app/src/templates/emails
EMAIL_LOG_RETENTION_DAYS=90

# ============================================================================
# SMS CONFIGURATION
# ============================================================================

# Africa's Talking
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username

# Twilio (Fallback)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SMS Configuration
SMS_MAX_LENGTH=160
SMS_RETRY_ATTEMPTS=3
SMS_RETRY_DELAY=5000

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================

# Stripe
STRIPE_PUBLIC_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# M-Pesa (Safaricom)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey

# IntaSend
INTASEND_PUBLIC_KEY=your_intasend_public_key
INTASEND_SECRET_KEY=your_intasend_secret_key

# Paystack
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_key

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=abancool-production
AWS_S3_URL_EXPIRY=3600

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# ============================================================================
# LOGGING AND MONITORING
# ============================================================================

# Log Level: error, warn, info, debug, trace
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=/var/log/abancool
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30
LOG_RETENTION_DAYS=90

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1

# DataDog APM (Optional)
DATADOG_ENABLED=false
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_NAME=abancool-api

# ============================================================================
# SECURITY
# ============================================================================

# CORS
ALLOWED_ORIGINS=https://app.abancool.com,https://admin.abancool.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_REDIS_ENABLED=true

# IP Control
IP_WHITELIST=
IP_BLACKLIST=

# HTTPS
SSL_CERT_PATH=/etc/ssl/certs/abancool.crt
SSL_KEY_PATH=/etc/ssl/private/abancool.key

# ============================================================================
# BACKUP AND RECOVERY
# ============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_TYPE=incremental # full or incremental
BACKUP_STORAGE_TYPE=s3 # s3, local, or both
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key

# Database Replication
DB_REPLICATION_ENABLED=false
DB_REPLICA_HOST=replica.db.abancool.com
DB_REPLICA_PORT=3306

# ============================================================================
# DEPLOYMENT
# ============================================================================

# PM2
PM2_MAX_MEMORY_RESTART=512M
PM2_NODE_ARGS=--max-old-space-size=4096

# Docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=abancool/api
DOCKER_IMAGE_TAG=latest

# Kubernetes (if applicable)
K8S_ENABLED=false
K8S_NAMESPACE=production
K8S_REPLICAS=3

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_PAYMENTS_ENABLED=true
FEATURE_SMS_ENABLED=true
FEATURE_EMAIL_ENABLED=true
FEATURE_BACKUP_ENABLED=true
FEATURE_REALTIME_ENABLED=true
FEATURE_SOCKET_IO_ENABLED=true
FEATURE_AUTOMATION_ENABLED=true

# ============================================================================
# MAINTENANCE
# ============================================================================

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are performing scheduled maintenance. We will be back online soon.
MAINTENANCE_EXEMPT_IPS=127.0.0.1,::1

# Update Notifications
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL=86400

# ============================================================================
# DEVELOPMENT ONLY (Never use in production)
# ============================================================================

# Debug
DEBUG=false
DEBUG_SQL=false
DEBUG_HTTP=false

# Swagger
SWAGGER_ENABLED=true
SWAGGER_URL=/api-docs

# Test
TEST_MODE=false
TEST_DATABASE_URL=
TEST_SEED_DATA=false
