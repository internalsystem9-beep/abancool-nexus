# ABANCOOL Production Environment Configuration
# Last Updated: May 2026

# Application Settings
NODE_ENV=production
PORT=4000
APP_VERSION=1.0.0
APP_NAME=ABANCOOL API

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=kzinlgmw_Panda
DB_PASSWORD=Laban@2030
DB_NAME=kzinlgmw_internal
DB_CONNECTION_LIMIT=20
DB_POOL_CLUSTER=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_characters_required_here
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_characters_required
JWT_REFRESH_EXPIRY=7d

# Authentication Settings
OTP_EXPIRY=10
OTP_LENGTH=6
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# Email Configuration (SMTP)
SMTP_HOST=mail.abancool.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@abancool.com
SMTP_PASSWORD=Laban@2030
SMTP_FROM_NAME=ABANCOOL Notifications
SMTP_FROM_EMAIL=noreply@abancool.com

# Email Configuration (IMAP - for inbox monitoring)
IMAP_HOST=mail.abancool.com
IMAP_PORT=993
IMAP_USER=noreply@abancool.com
IMAP_PASSWORD=Laban@2030
IMAP_TLS=true

# SMS Configuration - Africa's Talking
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=your_username_here
AFRICASTALKING_SENDER_ID=ABANCOOL

# SMS Configuration - Twilio
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_number_here

# SMS Configuration - Bulk SMS (TalkSasa)
BULKSMS_API_URL=https://bulksms.talksasa.com/api/v3
BULKSMS_API_TOKEN=2153|obu7jXdaPDyxCecwxopipnq9ofxX6TPElIQjOjEn211b1ea2
BULKSMS_SENDER_ID=ABAN_COOL
BULKSMS_MESSAGE_TYPE=plain
BULKSMS_ENABLED=true

# WhatsApp Configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id_here
WHATSAPP_BUSINESS_PHONE_NUMBER=your_phone_number_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Payment Gateway Configuration
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_PASSKEY=your_passkey_here
MPESA_BUSINESS_SHORT_CODE=your_short_code_here

# Sentry Configuration (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# DataDog Configuration (APM - Optional)
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_APP_NAME=abancool-api

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=/var/log/abancool
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30

# Monitoring Configuration
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=60
METRICS_COLLECTION_INTERVAL=300

# Alert Configuration
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_RECIPIENTS=admin@abancool.com
ALERT_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
ALERT_SMS_ENABLED=false
ALERT_SMS_RECIPIENTS=

# Security Configuration
HELMET_ENABLED=true
CORS_ORIGIN=https://app.abancool.com
CORS_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/abancool.crt
SSL_KEY_PATH=/etc/ssl/private/abancool.key
SSL_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=21600
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/abancool

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,zip
UPLOAD_DIR=/var/uploads/abancool

# Feature Flags
FEATURE_SMS_ENABLED=true
FEATURE_WHATSAPP_ENABLED=true
FEATURE_BACKUP_ENABLED=true
FEATURE_SOCKET_IO_ENABLED=true
FEATURE_AUDIT_LOGGING_ENABLED=true

# API Rate Limiting - Specific Endpoints
API_RATE_LIMIT_LOGIN=5/15min
API_RATE_LIMIT_REGISTER=3/hour
API_RATE_LIMIT_EMAIL=10/hour
API_RATE_LIMIT_SMS=10/hour

# Session Configuration
SESSION_SECRET=your_session_secret_min_32_characters_required_here
SESSION_TIMEOUT=3600
SESSION_STORE=redis
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true

# Encryption Configuration
ENCRYPTION_ALGORITHM=aes-256-cbc
ENCRYPTION_KEY=your_encryption_key_min_32_characters_required_here

# Admin Configuration
ADMIN_EMAIL=admin@abancool.com
SUPPORT_EMAIL=support@abancool.com
BILLING_EMAIL=billing@abancool.com

# Feature Toggles
DEBUG_MODE=false
VERBOSE_LOGGING=false
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_PHONE_VERIFICATION=false

# External Services
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_DELAY=1000
